@using PersonalFinanceTracker.Models

<EditForm Model="Model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="form-grid">
        <div class="form-group">
            <label>Type</label>
            <InputSelect @bind-Value="Model.TransactionType" @bind-Value:after="OnTypeChanged">
                <option value="Income">Income</option>
                <option value="Expense">Expense</option>
            </InputSelect>
        </div>

        <div class="form-group">
            <label>Account</label>
            <InputSelect @bind-Value="Model.AccountId">
                <option value="0">-- Select account --</option>
                @foreach (var account in Accounts)
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </InputSelect>
        </div>

        <div class="form-group">
            <label>Category</label>
            <InputSelect @bind-Value="Model.CategoryId">
                <option value="0">-- Select category --</option>
                @foreach (var category in FilteredCategories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </InputSelect>
        </div>

        <div class="form-group">
            <label>Amount</label>
            <InputNumber @bind-Value="Model.Amount" step="0.01" />
        </div>

        <div class="form-group">
            <label>Date</label>
            <InputDate @bind-Value="Model.TransactionDate" />
        </div>

        <div class="form-group full-width">
            <label>Description</label>
            <InputText @bind-Value="Model.Description" placeholder="Optional note" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-error">@ErrorMessage</div>
    }

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@SubmitLabel</button>
        @if (ShowCancel)
        {
            <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
        }
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public TransactionFormModel Model { get; set; } = new();
    [Parameter] public IEnumerable<Account> Accounts { get; set; } = [];
    [Parameter] public IEnumerable<Category> Categories { get; set; } = [];
    [Parameter] public EventCallback<TransactionFormModel> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Save Transaction";
    [Parameter] public bool ShowCancel { get; set; }

    private string? ErrorMessage;
    private IEnumerable<Category> FilteredCategories =>
        Categories.Where(c => c.Type.Equals(Model.TransactionType, StringComparison.OrdinalIgnoreCase));

    private void OnTypeChanged()
    {
        Model.CategoryId = 0;
    }

    private async Task HandleSubmit()
    {
        ErrorMessage = null;
        try
        {
            await OnSave.InvokeAsync(Model);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
}
