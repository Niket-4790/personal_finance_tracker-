@page "/transactions"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ICategoryService CategoryService

<PageTitle>Transactions - FinanceTrack</PageTitle>

<div class="page-header">
    <div>
        <h1>Transactions</h1>
        <p class="page-subtitle">@(isAdmin ? "Every user's transactions, read-only" : "Track income and expenses")</p>
    </div>
    @if (!isAdmin)
    {
        <button class="btn btn-primary" @onclick="ShowAddForm">+ Add Transaction</button>
    }
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success">@message</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error">@error</div>
}

@if (showForm)
{
    <div class="panel form-panel">
        <h3>@(editingId.HasValue ? "Edit Transaction" : "New Transaction")</h3>
        <TransactionForm Model="formModel"
                         Accounts="accounts"
                         Categories="categories"
                         OnSave="SaveTransaction"
                         OnCancel="CancelForm"
                         ShowCancel="true"
                         SubmitLabel="@(editingId.HasValue ? "Update" : "Create")" />
    </div>
}

<div class="panel">
    @if (loading)
    {
        <div class="loading">Loading transactions...</div>
    }
    else if (transactions.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    @if (isAdmin)
                    {
                        <th>User</th>
                    }
                    <th>Type</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Account</th>
                    <th>Amount</th>
                    @if (!isAdmin)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in transactions)
                {
                    <tr>
                        <td>@tx.TransactionDate.ToString("MMM dd, yyyy")</td>
                        @if (isAdmin)
                        {
                            <td>@tx.UserName</td>
                        }
                        <td><span class="badge @(tx.TransactionType == "Income" ? "badge-income" : "badge-expense")">@tx.TransactionType</span></td>
                        <td>@(string.IsNullOrWhiteSpace(tx.Description) ? "—" : tx.Description)</td>
                        <td><span class="badge" style="background:@tx.CategoryColor">@tx.CategoryName</span></td>
                        <td>@tx.AccountName</td>
                        <td class="@(tx.TransactionType == "Income" ? "text-income" : "text-expense")">
                            @(tx.TransactionType == "Income" ? "+" : "-")@tx.Amount.ToString("C")
                        </td>
                        @if (!isAdmin)
                        {
                            <td class="actions">
                                <button class="btn btn-sm" @onclick="() => EditTransaction(tx)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteTransaction(tx.Id)">Delete</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">No transactions found@(isAdmin ? "." : ". Click \"Add Transaction\" to get started.")</div>
    }
</div>


