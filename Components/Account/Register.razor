@page "/Account/Register"
@layout PersonalFinanceTracker.Components.Layout.AuthLayout
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Register - FinanceTrack</PageTitle>

<div class="sidebar-brand" style="justify-content:center; border-bottom:none; padding-bottom:0;">
    <span class="brand-icon">₹</span>
    <div><strong>FinanceTrack</strong></div>
</div>

<h1>Create your account</h1>
<p class="page-subtitle">Start tracking your personal finances.</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error">@error</div>
}

<EditForm Model="Input" OnValidSubmit="RegisterUser" FormName="register">
    <DataAnnotationsValidator />
    <div class="form-group">
        <label>Name</label>
        <InputText @bind-Value="Input.Name" />
        <ValidationMessage For="() => Input.Name" />
    </div>
    <div class="form-group">
        <label>Email</label>
        <InputText @bind-Value="Input.Email" />
        <ValidationMessage For="() => Input.Email" />
    </div>
    <div class="form-group">
        <label>Password</label>
        <InputText type="password" @bind-Value="Input.Password" />
        <ValidationMessage For="() => Input.Password" />
    </div>
    <div class="form-group">
        <label>Confirm Password</label>
        <InputText type="password" @bind-Value="Input.ConfirmPassword" />
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create account</button>
    </div>
</EditForm>

<p class="auth-footer">Already have an account? <a href="/Account/Login">Sign in</a></p>

