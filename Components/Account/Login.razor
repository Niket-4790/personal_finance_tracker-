@page "/Account/Login"
@layout PersonalFinanceTracker.Components.Layout.AuthLayout
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Sign in - FinanceTrack</PageTitle>

<div class="sidebar-brand" style="justify-content:center; border-bottom:none; padding-bottom:0;">
    <span class="brand-icon">₹</span>
    <div><strong>FinanceTrack</strong></div>
</div>

<h1>Sign in</h1>

<p class="page-subtitle">
    Track your income, expenses, and savings.
</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error">@error</div>
}

<EditForm Model="Input" OnValidSubmit="LoginUser" FormName="login">
    <DataAnnotationsValidator />

    <div class="form-group">
        <label>Email</label>
        <InputText @bind-Value="Input.Email" />
        <ValidationMessage For="() => Input.Email" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <InputText type="password" @bind-Value="Input.Password" />
        <ValidationMessage For="() => Input.Password" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            Sign in
        </button>
    </div>
</EditForm>

<div class="social-login">
    <div class="divider">
        <span>OR</span>
    </div>

    <a href="/Account/GoogleLogin" class="btn btn-google">
        Continue with Google
    </a>
</div>

<p class="auth-footer">
    Don't have an account?
    <a href="/Account/Register">Register</a>
</p>